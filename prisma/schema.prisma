generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon on Vercel). DATABASE_URL comes from the Neon integration
// in production; for local dev use a free Neon branch or any local Postgres.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Registration to an event (Couples Conference, etc.)
model EventRegistration {
  id        String   @id @default(cuid())
  event     String // event slug, e.g. "couples-conference"
  names     String
  email     String
  campus    String?
  createdAt DateTime @default(now())
}

// "Join online" request — someone asking for connection details
model JoinRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  source    String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Contact messages from a ministry sub-section (e.g. Women's Ministry),
// which collect a location and a subject the main contact form doesn't.
model MinistryContactMessage {
  id        String   @id @default(cuid())
  ministry  String // e.g. "women"
  name      String
  email     String
  location  String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

// Donations recorded from Stripe webhooks (or entered manually later)
model Donation {
  id              String   @id @default(cuid())
  amount          Int // in cents
  currency        String   @default("usd")
  interval        String   @default("one_time") // one_time | monthly
  donorName       String?
  donorEmail      String?
  method          String   @default("card") // card | paypal | zelle | interac
  stripeSessionId String?  @unique
  status          String   @default("completed")
  createdAt       DateTime @default(now())
}
