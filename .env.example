# Copy to .env and fill in real values.

# Database — Postgres. In production on Vercel the Neon integration provides
# this automatically. For local dev, create a free Neon branch (neon.com) or
# run a local Postgres and paste its connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public URL of the site (used for SEO metadata, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL="https://huiosnationworld.org"

# Admin dashboard password (/admin)
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie
ADMIN_SESSION_SECRET="change-me-too"

# Stripe (card donations). Leave empty to hide the card giving option.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal donation link (PayPal handles the payment page)
NEXT_PUBLIC_PAYPAL_DONATE_URL="https://www.paypal.com/donate"
